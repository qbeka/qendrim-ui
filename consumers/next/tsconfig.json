{
  "compilerOptions": { "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "preserve", "strict": true, "noEmit": true, "skipLibCheck": false, "esModuleInterop": true, "isolatedModules": true, "incremental": false, "allowJs": false, "resolveJsonModule": true, "plugins": [{ "name": "next" }] },
