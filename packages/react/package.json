{
  "name": "@qbeka/react",
  "version": "0.1.0",
  "description": "React components for interfaces that keep their continuity when content, layout and user intent change.",
  "license": "MIT",
  "author": "Qendrim Beka",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actionbar": {
      "types": "./dist/actionbar/index.d.ts",
      "default": "./dist/actionbar/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "default": "./dist/dialog/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "default": "./dist/field/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./inspector": {
      "types": "./dist/inspector/index.d.ts",
      "default": "./dist/inspector/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "default": "./dist/popover/index.js"
    },
    "./scope": {
      "types": "./dist/scope/index.d.ts",
      "default": "./dist/scope/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "default": "./dist/select/index.js"
    },
    "./surface": {
      "types": "./dist/surface/index.d.ts",
      "default": "./dist/surface/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "default": "./dist/tabs/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "default": "./dist/timeline/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "default": "./dist/tooltip/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbeka/qendrim-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "components",
    "base-ui",
    "accessibility",
    "animation"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*/index.d.ts"
      ]
    }
  }
}
